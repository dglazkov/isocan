#!/bin/sh
# **When code lands, tell the canvas.**
#
# The write half of `docs/research/2026-08-30-repo-admin-canvas.md`, for the one
# place it is buildable today: this machine. CI cannot reach a canvas — no
# daemon, no badge, no route in — but the machine you commit on is the machine
# the daemon is running on, so a git hook is the whole mechanism.
#
# Installed by `node scripts/install-hooks.mjs`. Removed by deleting
# `.git/hooks/post-commit`, which is a symlink to this file.
#
# Two rules it keeps:
#
#   1. **It can never fail your commit.** The commit already happened; a canvas
#      that was unreachable is not a reason to make you think it did not. Every
#      path here exits 0.
#   2. **It never blocks your terminal.** Taking eleven metrics is ~15 seconds,
#      which is unacceptable in front of a prompt, so the run is detached and
#      writes to a log you are told the name of. Silent background work is the
#      thing that gets removed in week two; a named log is why this one stays.
set -u
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# **The roadmap's canvas card**, on a machine that opted in by writing
# `.isocan/roadmap.json` (`{"canvas":"prj_OE-AuGl119"}`). Same two rules:
# detached, logged, and never this commit's problem — `roadmap.mjs --publish`
# leaves the card alone when its bytes have not changed, so most commits cost
# a read. It runs before the board's checks below because it is not the
# board's, and the watcher does not do it.
# Not mid-rebase: git runs this hook for every replayed commit, and a publish
# of each intermediate tree is noise. The commit after the rebase publishes.
gitdir=$(git -C "$root" rev-parse --git-dir 2>/dev/null || echo "$root/.git")
case "$gitdir" in /*) ;; *) gitdir="$root/$gitdir" ;; esac
if [ -f "$root/.isocan/roadmap.json" ] && [ ! -d "$gitdir/rebase-merge" ] && [ ! -d "$gitdir/rebase-apply" ]; then
  {
    printf '\n── %s  %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git -C "$root" rev-parse --short HEAD)"
    node "$root/scripts/roadmap.mjs" --publish 2>&1
    printf 'exit %s\n' "$?"
  } >>"$root/.isocan/roadmap.log" 2>&1 &
  echo "isocan: refreshing the roadmap's canvas card → .isocan/roadmap.log"
fi

# No board configured on this machine — nothing to tell, and nothing to say
# about it. `.isocan/` is git-ignored, so this is per-machine by construction.
[ -f "$root/.isocan/board.json" ] || exit 0

# **Stand down if the watcher has this.** Both of us react to a commit, and
# running both put every announcement in the Chat twice. The watcher is the
# better of the two — it debounces, and it sees HEAD move however it moved — so
# it claims the job with a pidfile and this checks whether that process is
# still alive. A stale pidfile from a killed watcher does not silence us: the
# kill `-0` is the liveness test, not the file's existence.
pid=$(cat "$root/.isocan/board-watch.pid" 2>/dev/null || true)
if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
  echo "isocan: board:watch (pid $pid) has this one"
  exit 0
fi

log="$root/.isocan/board.log"
{
  printf '\n── %s  %s  %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$(git -C "$root" rev-parse --short HEAD)" \
    "$(git -C "$root" log -1 --pretty=%s)"
  node "$root/scripts/canvas-board.mjs" --notify 2>&1
  printf 'exit %s\n' "$?"
} >>"$log" 2>&1 &

echo "isocan: refreshing the board and telling the Chat → .isocan/board.log"
exit 0

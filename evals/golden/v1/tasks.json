      "checks": [
        { "kind": "text", "text": "Settings" },
        { "kind": "no-text", "text": "Preferences" },
        { "kind": "unchanged", "selector": "form" },
        { "kind": "screen", "names": ["renders", "no contrast failures"] }
      ]
    },

{
  "schemaVersion": 1,
  "id": "button-treatment",
  "family": "Button treatment",
  "title": "Acme compact action",
  "instruction": "Remove the caller overrides of Button-owned padding and radius. Retain data-isocan-recipe=\"Button\" and data-isocan-treatment=\"compact\": the compact treatment uses 8px padding and the control radius is 8px. Preserve the Save selection label, keyboard focus and native click confirmation at both sizes. Do not change policy or add exceptions.",
  "files": {
    "initial": "initial.html",
    "repaired": "repaired.html",
    "design": "DESIGN.md"
  },

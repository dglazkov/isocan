    "kind": "canvas"
  },
  "viewports": [
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 1280,
      "height": 900
    }
  ],
  "expected": {
    "initialDiagnostics": [
      {
        "code": "design/owned-value",
        "property": "padding-top",
        "actual": "32px"
      },
      {
        "code": "design/owned-value",
        "property": "padding-right",
        "actual": "32px"
      },
      {
        "code": "design/owned-value",
        "property": "padding-bottom",
        "actual": "32px"
      },
      {
        "code": "design/owned-value",
        "property": "padding-left",
        "actual": "32px"
      },
      {
        "code": "design/owned-value",
        "property": "border-top-left-radius",
        "actual": "16px"
      },
      {
        "code": "design/owned-value",
        "property": "border-top-right-radius",
        "actual": "16px"
      },
      {
        "code": "design/owned-value",
        "property": "border-bottom-right-radius",
        "actual": "16px"
      },
      {
        "code": "design/owned-value",
        "property": "border-bottom-left-radius",
        "actual": "16px"
      }
    ],
    "initialCoverageComplete": true,
    "repairedDiagnostics": 0,
    "repairedCoverageComplete": true,
    "unchangedControl": false
  },
  "invariants": {
    "required": [
      {
        "selector": "body",
        "tag": "body",
        "computed": {
          "background-color": "rgb(244, 247, 250)",
          "padding-top": "16px"
        }
      },
      {
        "selector": "#card",
        "tag": "main",
        "computed": {
          "padding-top": "16px",
          "padding-right": "16px",
          "padding-bottom": "16px",
          "padding-left": "16px",
          "border-top-left-radius": "8px",
          "background-color": "rgb(255, 255, 255)"
        }
      },
      {
        "selector": "#title",
        "tag": "h1",
        "text": "Keep the action compact",
        "minFontSize": 24,
        "computed": {
          "font-size": "24px",
          "line-height": "30px"
        }
      },
      {
        "selector": "#description",
        "tag": "p",
        "text": "A compact action completes this card. Its shape belongs to the Button recipe and its compact treatment.",
        "minFontSize": 16,
        "computed": {
          "font-size": "16px",
          "line-height": "24px",
          "color": "rgb(32, 48, 64)"
        }
      },
      {
        "selector": "#accent",
        "tag": "strong",
        "text": "Compact control",
        "minFontSize": 16,
        "computed": {
          "color": "rgb(40, 92, 152)"
        }
      },
      {
        "selector": "#action",
        "tag": "button",
        "text": "Save selection",
        "minFontSize": 16,
        "computed": {
          "font-size": "16px",
          "padding-top": "8px",
          "padding-right": "8px",
          "padding-bottom": "8px",
          "padding-left": "8px",
          "border-top-left-radius": "8px",
          "color": "rgb(255, 255, 255)",
          "background-color": "rgb(40, 92, 152)"
        },
        "recipe": "Button",
        "attributes": {
          "data-isocan-treatment": "compact"
        }
      }
    ],
    "distinctStyles": [
      {
        "left": "#description",
        "right": "#accent",
        "property": "color"
      }
    ],
    "interaction": {
      "triggerSelector": "#action",
      "targetSelector": "#feedback",
      "visibleText": "The selection is saved for this example."
    },
    "minimumStyleElements": 1,
    "requireViewportFit": true,
    "requireUnclippedText": true
  }

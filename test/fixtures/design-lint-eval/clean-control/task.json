{
  "schemaVersion": 1,
  "id": "clean-control",
  "family": "Clean control",
  "title": "Acme unchanged sample",
  "instruction": "Check this already conforming card and return it unchanged. The local ink alias is valid, and #ff00ff in the paragraph is prose. Preserve exact HTML bytes, visible content, semantic elements and the working Check sample button at both sizes. Do not change the design document.",
  "files": {
    "initial": "initial.html",
    "repaired": "repaired.html",
    "design": "DESIGN.md"
  },
  "scope": {
    "kind": "canvas"
  },
  "viewports": [
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 1280,
      "height": 900
    }
  ],
  "expected": {
    "initialDiagnostics": [],
    "initialCoverageComplete": true,
    "repairedDiagnostics": 0,
    "repairedCoverageComplete": true,
    "unchangedControl": true
  },
  "invariants": {
    "required": [
      {
        "selector": "body",
        "tag": "body",
        "computed": {
          "background-color": "rgb(244, 247, 250)",
          "padding-top": "16px"
        }
      },
      {
        "selector": "#card",
        "tag": "main",
        "computed": {
          "padding-top": "16px",
          "padding-right": "16px",
          "padding-bottom": "16px",
          "padding-left": "16px",
          "border-top-left-radius": "8px",
          "background-color": "rgb(255, 255, 255)"
        }
      },
      {
        "selector": "#title",
        "tag": "h1",
        "text": "Keep this sample intact",
        "minFontSize": 24,
        "computed": {
          "font-size": "24px",
          "line-height": "30px"
        }
      },
      {
        "selector": "#description",
        "tag": "p",
        "text": "The sample string #ff00ff is written content, not a color declaration. The local ink alias already resolves to the declared ink.",
        "minFontSize": 16,
        "computed": {
          "font-size": "16px",
          "line-height": "24px",
          "color": "rgb(32, 48, 64)"
        }
      },
      {
        "selector": "#accent",
        "tag": "strong",
        "text": "Verified reading sample",
        "minFontSize": 16,
        "computed": {
          "color": "rgb(40, 92, 152)"
        }
      },
      {
        "selector": "#action",
        "tag": "button",
        "text": "Check sample",
        "minFontSize": 16,
        "computed": {
          "font-size": "16px",
          "padding-top": "8px",
          "padding-right": "8px",
          "padding-bottom": "8px",
          "padding-left": "8px",
          "border-top-left-radius": "8px",
          "color": "rgb(255, 255, 255)",
          "background-color": "rgb(40, 92, 152)"
        }
      }
    ],
    "distinctStyles": [
      {
        "left": "#description",
        "right": "#accent",
        "property": "color"
      }
    ],
    "interaction": {
      "triggerSelector": "#action",
      "targetSelector": "#feedback",
      "visibleText": "The unchanged sample still responds."
    },
    "minimumStyleElements": 1,
    "requireViewportFit": true,
    "requireUnclippedText": true
  }
}

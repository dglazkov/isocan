{
  "schemaVersion": 1,
  "id": "scoped-lane",
  "family": "Scoped lane",
  "title": "Acme selected lane",
  "instruction": "The real Field Notes group governs this card with a 16px medium spacing step. Replace the borrowed 24px Gallery lane padding with the selected lane token. Preserve both design documents and their histories, all visible text and the working Confirm lane button. Do not reassign the card to another group.",
  "files": {
    "initial": "initial.html",
    "repaired": "repaired.html",
    "design": "DESIGN.md",
    "adjacentDesign": "adjacent-DESIGN.md"
  },
  "scope": {
    "kind": "group",
    "groupTitle": "Field Notes",
    "adjacentGroupTitle": "Gallery"
  },
  "viewports": [
    {
      "width": 390,
      "height": 844
    },
    {
      "width": 1280,
      "height": 900
    }
  ],
  "expected": {
    "initialDiagnostics": [
      {
        "code": "design/off-scale-spacing",
        "property": "padding",
        "actual": "24px"
      }
    ],
    "initialCoverageComplete": true,
    "repairedDiagnostics": 0,
    "repairedCoverageComplete": true,
    "unchangedControl": false
  },
  "invariants": {
    "required": [
      {
        "selector": "body",
        "tag": "body",
        "computed": {
          "background-color": "rgb(244, 247, 250)",
          "padding-top": "16px"
        }
      },
      {
        "selector": "#card",
        "tag": "main",
        "computed": {
          "padding-top": "16px",
          "padding-right": "16px",
          "padding-bottom": "16px",
          "padding-left": "16px",
          "border-top-left-radius": "8px",
          "background-color": "rgb(255, 255, 255)"
        }
      },
      {
        "selector": "#title",
        "tag": "h1",
        "text": "Follow the selected lane",
        "minFontSize": 24,
        "computed": {
          "font-size": "24px",
          "line-height": "30px"
        }
      },
      {
        "selector": "#description",
        "tag": "p",
        "text": "This card belongs to the Field Notes lane. The neighboring Gallery lane has a different spacing step.",
        "minFontSize": 16,
        "computed": {
          "font-size": "16px",
          "line-height": "24px",
          "color": "rgb(32, 48, 64)"
        }
      },
      {
        "selector": "#accent",
        "tag": "strong",
        "text": "Field Notes lane",
        "minFontSize": 16,
        "computed": {
          "color": "rgb(40, 92, 152)"
        }
      },
      {
        "selector": "#action",
        "tag": "button",
        "text": "Confirm lane",
        "minFontSize": 16,
        "computed": {
          "font-size": "16px",
          "padding-top": "8px",
          "padding-right": "8px",
          "padding-bottom": "8px",
          "padding-left": "8px",
          "border-top-left-radius": "8px",
          "color": "rgb(255, 255, 255)",
          "background-color": "rgb(40, 92, 152)"
        }
      }
    ],
    "distinctStyles": [
      {
        "left": "#description",
        "right": "#accent",
        "property": "color"
      }
    ],
    "interaction": {
      "triggerSelector": "#action",
      "targetSelector": "#feedback",
      "visibleText": "The Field Notes lane is confirmed."
    },
    "minimumStyleElements": 1,
    "requireViewportFit": true,
    "requireUnclippedText": true
  }
}

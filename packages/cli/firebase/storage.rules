rules_version = '2';

// The canned Cloud Storage rules `isocan share` deploys (#69). Closed for the
// same reason the Firestore rules are: provisioning precedes minting, so there
// is nobody yet who ought to read these bytes.
//
// #71 opens `blobs/{hash}` and `entries/{seq}.json` reads to a member, gated by
// a cross-service `firestore.get()` on the membership doc — both hold canvas
// content, so both answer to the same membership. Phase 4 opens
// `pending-blobs`, the staging area where an edit-tier guest leaves bytes the
// host has not hashed yet — which is why guest uploads never write to `blobs/`
// directly.

service firebase.storage {
  match /b/{bucket}/o {

    // Content-addressed and verified: written only by the host's daemon.
    match /blobs/{hash} {
      allow read, write: if false;
    }

    // Mirror entries too big to be a Firestore document (#70). Firestore
    // refuses a property over 1,048,487 bytes, and an entry can exceed that —
    // a very long comment, or the inverse of a delete that took thousands of
    // items with it — so the document carries the address and the entry lives
    // here. A reader that can read `ops` must be able to read these: they ARE
    // ops, wearing a different coat.
    match /entries/{seq} {
      allow read, write: if false;
    }

    // Unverified guest bytes, awaiting the host's own hash. Phase 4.
    match /pending-blobs/{hash} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

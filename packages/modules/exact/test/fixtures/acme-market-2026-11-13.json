    "sources": {
      "app.contract": "// Acme Market: two tabs, each its own stack: a list that pushes a detail in each.\n// The root tablist is the iOS tab bar; a screen a tab pushed survives a visit to the other.\n// Each tab's list has the bar's search field, its own query (`contract vocab search`).\n// App-drawn bars have a different layout: run `bun exact.mjs contract vocab tabs`.\n// A native badge uses its box's inner text; XCUITest finds the tab by `tab-saved`.\nuse EmptyState from \"exact:content\"\n\nroutes nav\n  tab places \"/\"\n    place \"/place/:id\"\n  tab saved \"/saved\"\n    savedPlace \"/saved/:id\"\n\n"
    }
  }

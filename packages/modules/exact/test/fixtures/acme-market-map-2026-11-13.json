  "sources": {
   "app.contract": "// Acme Market: two tabs, each its own stack: a list that pushes a detail in each.\n// The root tablist is the iOS tab bar; a screen a tab pushed survives a visit to the other.\n// Each tab's list has the bar's search field, its own query (`contract vocab search`).\n// App-drawn bars have a different layout: run `bun exact.mjs contract vocab tabs`.\n// A native badge uses its box's inner text; XCUITest finds the tab by `tab-saved`.\nuse EmptyState from \"exact:content\"\n\nroutes nav\n  tab places \"/\"\n    place \"/place/:id\"\n  tab saved \"/saved\"\n    savedPlace \"/saved/:id\"\n\nshape Place\n  id: string\n  name: string\n  area: string\n  about: string\n\nfn nameOf(places: Place[], id: string): string = match first(places.filter(p => p.id == id)) { case some(p) => p.name, case none => \"\" }\nfn matches(p: Place, q: string): bool = p.name.toLowerCase().includes(q.trim().toLowerCase()) or p.area.toLowerCase().includes(q.trim().toLowerCase())\n\ncomponent App\n  state saved = [] persist\n  state placesQuery = \"\"\n  state savedQuery = \"\"\n  resource places = loadPlaces() as shape Place[] else empty()\n  derive placesShown = places.filter(p => matches(p, placesQuery))\n  derive savedShown = places.filter(p => saved.includes(p.id) and matches(p, savedQuery))\n  action pick(name: string)\n    nav = select(nav, name)\n  // A row is a link to its place; the browser's Back, Forward and a deep link arrive here too.\n  action follow(url: string)\n    nav = go(nav, url)\n  action search(tab: string, v: string)\n    if tab == \"saved\"\n      savedQuery = v\n    else\n      placesQuery = v\n  // The empty Saved tab's button opens the first place on top of it.\n  action browse\n    nav = push(nav, path(\"savedPlace\", \"1\"))\n  action toggle(id: string)\n    saved = saved.includes(id) ? saved.filter(s => s != id) : saved.concat([id])\n  view\n    main navigationKey=`${top(nav).id}` navigationBack=\"back\" navigate=follow testId=\"app\" width=\"100%\" height=\"100%\"\n      display=\"flex\" flex-direction=\"column\"\n      column flex=1 min-height=0 position=\"relative\"\n        for t in nav.tabs key=t.name\n          column role=\"tabpanel\" id=`panel-${t.name}` position=\"absolute\" inset=0\n            for e in t.stack key=e.id\n              column navigationKey=`${e.id}` navigationScroll=`content-${e.id}` position=\"absolute\" inset=0\n                display=\"flex\" flex-direction=\"column\"\n                header display=\"flex\" flex-wrap=\"wrap\" align-items=\"center\" gap=8 padding=\"8px 16px\"\n                  text (e.name == \"places\" ? \"Acme Market\" : e.name == \"saved\" ? \"Saved\" : nameOf(places, e.params.id))\n                    role=\"heading\" aria-level=(e.name == \"places\" or e.name == \"saved\" ? 1 : 2) flex=1 color=\"brand.ink\"\n                  if e.name == \"place\" or e.name == \"savedPlace\"\n                    button press=toggle(e.params.id) aria-label=(saved.includes(e.params.id) ? \"Remove from Saved\" : \"Save\")\n                      testId=`save-${t.name}`\n                      image (saved.includes(e.params.id) ? \"symbol:bookmark-fill\" : \"symbol:bookmark\")\n                  if e.name == \"places\" or (e.name == \"saved\" and saved.length > 0)\n                    input type=\"search\" value=(t.name == \"saved\" ? savedQuery : placesQuery) input=search(t.name)\n                      placeholder=\"Search\" aria-label=(t.name == \"saved\" ? \"Search Saved\" : \"Search Places\")\n                      testId=`search-${t.name}` width=\"100%\"\n                if e.name == \"places\" or e.name == \"place\"\n                  ShippingNote()\n                // An empty tab and a search with no match are each an `EmptyState` in the list's place.\n                if e.name == \"saved\" and saved.length == 0\n                  EmptyState(symbol=\"symbol:bookmark\", title=\"No Saved Places\", message=\"Open a place and tap the bookmark.\")\n                    button press=browse testId=\"browse\"\n                      text \"Browse\"\n                else if e.name == \"places\" or e.name == \"saved\"\n                  if (t.name == \"saved\" ? savedShown : placesShown).length == 0 and not pending(places)\n                    EmptyState(symbol=\"symbol:search\", title=\"No Results\", message=\"Check the spelling or try a new search.\")\n                  else\n                    list id=`content-${e.id}` appearance=\"auto\" listStyle=\"inset-grouped\" flex=1 min-height=0\n                      section\n                        for p in (t.name == \"saved\" ? savedShown : placesShown) key=p.id\n                          link href=(e.name == \"saved\" ? path(\"savedPlace\", p.id) : path(\"place\", p.id)) testId=`${t.name}-${p.id}`\n                            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4\n                              text p.name\n                              text p.area font=\"-exact-subheadline\" color=\"-exact-secondary-label\"\n                            image \"symbol:forward-chevron\"\n                else\n                  list id=`content-${e.id}` appearance=\"auto\" listStyle=\"inset-grouped\" flex=1 min-height=0\n                    for p in places.filter(x => x.id == e.params.id) key=p.id\n                      section\n                        row\n                          text \"Area\"\n                          text p.area\n                      section\n                        row padding-top=10 padding-bottom=10\n                          text p.about flex=1 min-width=0 testId=`about-${t.name}`\n      row role=\"tablist\" testId=\"tabs\"\n        button role=\"tab\" aria-controls=\"panel-places\" aria-selected=(nav.tab == \"places\") press=pick(\"places\")\n          testId=\"tab-places\" flex=1\n          image \"symbol:home\"\n          text \"Places\"\n        button role=\"tab\" aria-controls=\"panel-saved\" aria-selected=(nav.tab == \"saved\") press=pick(\"saved\")\n          testId=\"tab-saved\" flex=1\n          image \"symbol:bookmark\"\n          text \"Saved\"\n          if saved.length > 0\n            row background-color=\"-exact-system-red\" border-radius=12\n              text `${saved.length}` font-variant-numeric=\"tabular-nums\"\n\n// One line of shop copy, shown on the places list and a place's page only.\ncomponent ShippingNote\n  view\n    text \"Free shipping on orders over $50\" font=\"-exact-footnote\" color=\"note.ink\"\n      padding=\"4px 16px\" testId=\"shipping-note\"\n"
  },
  "tests": [
   {
    "file": "app.test.contract",
    "tests": [
     {
      "name": "each tab keeps its own stack",
      "steps": [
       {
        "op": "tap",
        "target": "places-2",
        "form": "press",
        "line": 2
       },
       {

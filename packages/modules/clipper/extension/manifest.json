{
  "manifest_version": 3,
  "name": "isocan Clipper",
  "version": "0.1.0",
  "description": "Clip the active browser tab or text selection onto an isocan canvas.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Clip to isocan",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
